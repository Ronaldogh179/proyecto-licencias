# Entorno de despliegue: development | staging | production
ENVIRONMENT=development

# Configuración de Base de Datos Híbrida Supabase (PostgreSQL + pgvector)
# Usar siempre la URL remota del proyecto Supabase, nunca localhost.
SUPABASE_URL=https://tu-proyecto-id.supabase.co
SUPABASE_KEY=tu-anon-key-o-service-role-key
SUPABASE_SECRET_KEY=tu-service-role-key-solo-para-backend

# Configuración Criptográfica JWT (Cumplimiento Ley N.° 29733)
JWT_SECRET_KEY=cambia-esta-clave-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8
